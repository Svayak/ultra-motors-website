  <link rel="apple-touch-icon" href="apple-touch-icon.png" />
</head>
<body>

  <header class="site-header">
    <div class="container nav">
      <a href="index.html" class="brand"><img src="css/logo.svg" alt="Ultra Motors AB" class="brand-logo" /></a>
      <nav>
        <button class="nav-toggle" aria-label="Meny"><span></span><span></span><span></span></button>
        <ul class="nav-links">
          <li><a href="index.html">Hem</a></li>
          <li><a href="om-ultra.html">Om Ultra</a></li>
